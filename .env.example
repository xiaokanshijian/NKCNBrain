# Copy this file to `.env` in the repo root or `backend/` and fill in the values you actually use.
# Never commit a real `.env`.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL
MYSQL_DATABASE=bishe5
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# OpenAI-compatible proxy used by many Claude/GPT/Grok/GLM configs
NKCN_LLM_API_KEY=

# Official / vendor keys
