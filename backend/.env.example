# Copy to .env; never commit the filled file.
# Generate DJANGO_SECRET_KEY locally (python -c "import secrets; print(secrets.token_urlsafe(48))").
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DB_NAME=nkcn
DJANGO_DB_USER=nkcn
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=3306
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8080

# Model credentials. Multiple legacy call sites may share a provider variable.
DEEPSEEK_API_KEY=
KIMI_API_KEY=
NKCN_BAICHUAN_M2_OPENAI_API_KEY=
NKCN_CHAT_MIXTRAL_MODEL_API_KEY=
NKCN_CLAUDE_3_5_NATIVET_ANTHROPIC_API_KEY=
NKCN_CLAUDE_API_API_KEY=
NKCN_DEEPSEEKR1_TENCENT_OPENAI_API_KEY=
NKCN_DOUBAO_SEED_2_0_PRO_OPENAI_API_KEY=
NKCN_GPT4_API_API_KEY=
NKCN_HUGGFACE_GET_MODEL_API_KEY=
NKCN_KIMI_K3_OPENAI_API_KEY=
NKCN_LLM_DASHSCOPE_API_KEY=
NKCN_LLM_DMXAPI_API_KEY=
NKCN_R_LAYER_GEMINI_REPRO_API_KEY=
NKCN_VIEWS_CARD_IMAGE_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=
VOLCANO_TTS_ACCESS_TOKEN=
XFYUN_API_KEY=
XFYUN_API_SECRET=
XFYUN_APP_ID=

# Custom gateways and local inference services
NKCN_LEGACY_GATEWAY_V1_URL=http://localhost:9999/v1
NKCN_MODEL_GATEWAY_URL=http://localhost:9999
NKCN_MODEL_GATEWAY_V1_URL=http://localhost:9999/v1
NKCN_REVIEW_GATEWAY_V1_URL=http://localhost:9999/v1/
NKCN_SERVICE_8000_API_ASSESS_DOCUMENT_CONFIDENCE_URL=http://localhost:8000/api/assess_document_confidence/
NKCN_SERVICE_8000_API_GET_DEPTH_SUGGESTION_URL=http://localhost:8000/api/get_depth_suggestion/
NKCN_SERVICE_8000_API_INVOKE_RATE_STREAM_URL=http://localhost:8000/api/invoke_rate_stream/
NKCN_SERVICE_8000_API_INVOKE_RATE_URL=http://localhost:8000/api/invoke_rate/
NKCN_SERVICE_8000_API_MODEL_SWITCH_URL=http://localhost:8000/api/model_switch/
NKCN_SERVICE_8000_API_PROCESS_OCR_DOCUMENT_URL=http://localhost:8000/api/process_ocr_document/
NKCN_SERVICE_8000_API_RECEIVE_FILE_URL=http://localhost:8000/api/receive_file/
NKCN_SERVICE_8000_INVOKE_RATE_STREAM_URL=http://localhost:8000/invoke_rate_stream
NKCN_SERVICE_8000_OCR_FORWARD_URL=http://localhost:8000/ocr_forward
NKCN_SERVICE_8000_URL=http://localhost:8000

# Optional Volcengine speech account identifier
VOLCANO_TTS_APP_ID=

# Login/voice cookies. Keep frontend and backend on the same hostname locally.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
DJANGO_SESSION_COOKIE_AGE=43200
DJANGO_COOKIE_SAMESITE=Lax
DJANGO_COOKIE_SECURE=0
# For genuinely cross-site HTTPS deployments, use SameSite=None and Secure=1.

# Optional Baidu document translation. Use newly issued credentials only.
BAIDU_TRANS_APPID=
BAIDU_TRANS_SECKEY=
